# Copy to .env (gitignored). ks.cloud and the Makefile read it.
GOOGLE_CLOUD_PROJECT=           # chosen in M0
REGION=us-central1              # GPUs + bucket (ADR-009)
FALLBACK_REGION=europe-west4
BUCKET=                         # gs://<project>-knight-school
AR_REPO=knight-school           # Artifact Registry repo (docker)
RUNNER_SA=                      # ks-runner@<project>.iam.gserviceaccount.com
STOCKFISH=~/.local/bin/stockfish
HF_TOKEN=                       # M6 only, for the Hugging Face upload
WANDB_API_KEY=                  # only if the user chose W&B in M0
